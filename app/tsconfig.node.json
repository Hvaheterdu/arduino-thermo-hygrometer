{
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "types": [
      "@testing-library/dom",
      "@testing-library/jest-dom",
      "@testing-library/react",
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "tsBuildInfoFile": "node_modules/.tsconfig/tsconfig.node.tsbuildinfo"
  },
  "exclude": ["dist", "node_modules"],
  "include": ["vite.config.ts"]
}
