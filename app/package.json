{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "description": "The frontend application for a Java Web API that measures temperature and air humidity through a Arduino thermo hygrometer IoT device.",
  "keywords": [
    "Air humidity",
    "Arduino",
    "IoT",
    "Java",
    "Maven",
    "Postgres",
    "React",
    "Spring Boot",
    "Temperature",
    "TypeScript"
  ],
  "bugs": {
    "url": "https://github.com/Hvaheterdu/arduino-thermo-hygrometer/issues",
    "email": "burhan.mohammad.sarfraz@outlook.com"
  },
  "license": "MIT",
  "author": "Burhan Mohammad Sarfraz <burhan.mohammad.sarfraz@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hvaheterdu/arduino-thermo-hygrometer"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:production",
    "build:dev": "tsc -b && vite build --mode development",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "dev": "vite --mode development",
    "generate-types": "npm --prefix tools/openapi run generate",
    "generate-types:check": "npm --prefix tools/openapi run check",
    "setup:types": "npm --prefix tools/openapi ci",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "8.4.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.15.0"
  },
  "development": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version",
    "last 1 edge version"
  ]
}
