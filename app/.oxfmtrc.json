{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "experimentalOperatorPosition": "start",
  "insertFinalNewline": true,
  "trailingComma": "none",
  "printWidth": 120,
  "semi": true,
  "sortPackageJson": true,
  "sortImports": true,
  "ignorePatterns": [
    ".idea",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "**/*.d.ts",
    "**/*.generated.ts",
    "package-lock.json"
  ]
}
