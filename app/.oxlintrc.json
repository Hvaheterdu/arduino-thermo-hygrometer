{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "warn",
    "nursery": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "build",
    "coverage",
    "dist",
    "node_modules",
    "vite.config.ts",
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/.git",
    "**/.svn",
    "**/.hg"
  ]
}
