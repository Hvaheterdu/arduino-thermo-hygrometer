{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "warn",
    "nursery": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "api",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "app/vite.config.ts",
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/.git",
    "**/.svn",
    "**/.hg"
  ]
}
