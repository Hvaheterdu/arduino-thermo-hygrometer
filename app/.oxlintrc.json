{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "warn",
    "nursery": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".idea",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "**/*.d.ts",
    "**/*.generated.ts",
    "package-lock.json",
    "vite.config.ts"
  ]
}
